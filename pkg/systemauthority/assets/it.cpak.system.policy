<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/software/polkit/policyconfig-1.dtd">
<policyconfig>
  <vendor>cpak</vendor>
  <vendor_url>https://cpak.it</vendor_url>

  <action id="it.cpak.system.register-session">
    <description>Register a cpak login session</description>
    <message>Authentication is required to register this cpak login session</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>

  <action id="it.cpak.system.remove-session">
    <description>Remove a cpak login session</description>
    <message>Authentication is required to remove this cpak login session</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>

  <!-- Recording what an install just put on disk, for the account doing the
       installing, with a policy that is no wider than the one already
       recorded. That is the ordinary course of installing software, so it is
       allowed at an active local session and nowhere else. -->
  <action id="it.cpak.system.enrol-anchor">
    <description>Record a cpak application in the integrity ledger</description>
    <message>Authentication is required to record this cpak application in the integrity ledger</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
  </action>

  <!-- The same enrolment when it hands the application more than it already
       has, when it puts it back to a generation it left, or when it is made
       for another account. Which of the two actions is asked for is decided by
       the authority against what the ledger holds, never by the caller. -->
  <action id="it.cpak.system.widen-anchor">
    <description>Widen what a cpak application is enrolled for</description>
    <message>Authentication is required to let this cpak application be enrolled with more than it has now</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>

  <!-- Forgetting one's own anchor leaves one's own application unenrolled,
       which is the state enforcement refuses, so an active session may do it
       while removing its own software. -->
  <action id="it.cpak.system.forget-anchor">
    <description>Remove a cpak application from the integrity ledger</description>
    <message>Authentication is required to remove this cpak application from the integrity ledger</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
  </action>

  <!-- The same removal aimed at another account. The anchor is the only record
       the rules against going backwards are derived from, so taking somebody
       else's away makes the next install of an older release look like a first
       enrolment with nothing to compare it against. Which of the two actions is
       asked for is decided by the authority from the caller the bus names,
       never by the caller. -->
  <action id="it.cpak.system.forget-anchor-other">
    <description>Remove another account's cpak application from the integrity ledger</description>
    <message>Authentication is required to remove another account's cpak application from the integrity ledger</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>

  <!-- Whether this host enrols packages no publisher signed. Turning it on
       stops software installing into the ledger for every account on the
       machine, and turning it off takes that protection away again, so both
       directions are the owner of the machine's decision. -->
  <action id="it.cpak.system.set-signature-policy">
    <description>Set whether cpak enrols packages no publisher signed</description>
    <message>Authentication is required to change whether cpak enrols packages no publisher signed</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>

  <!-- Who may publish for this host, which origins it takes software from at
       all, and which releases have had that trust withdrawn. It is the one
       decision no package can make for the machine, so it is the owner of the
       machine's and nobody else's, in both directions: naming an approved
       publisher protects every account on the host and unnaming one takes that
       protection away. Reading the policy is not an action, because a caller
       that cannot read the rules it is judged by cannot explain a refusal. -->
  <action id="it.cpak.system.set-trust-policy">
    <description>Set which publishers and origins cpak accepts on this host</description>
    <message>Authentication is required to change which publishers and origins cpak accepts on this host</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>

  <action id="it.cpak.system.set-enforcement">
    <description>Set what cpak does with an application it cannot recognise</description>
    <message>Authentication is required to change how cpak treats an application it cannot recognise</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>
</policyconfig>
