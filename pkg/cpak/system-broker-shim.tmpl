set -e

case "$(basename "$0")" in
    notify-send) OPERATION=notify ;;
    xdg-open) OPERATION=open-uri ;;
    cpak-launch-app) OPERATION=launch-application ;;
    *) echo "CPAK SYSTEM BROKER ERROR: unsupported shim." >&2; exit 1 ;;
esac

if [ -z "$CPAK_SYSTEM_BROKER_SOCKET" ] || [ -z "$CPAK_SYSTEM_BROKER_TOKEN_FILE" ]; then
    echo "CPAK SYSTEM BROKER ERROR: broker is unavailable." >&2
    exit 1
fi

if [ ! -S "$CPAK_SYSTEM_BROKER_SOCKET" ] || [ ! -r "$CPAK_SYSTEM_BROKER_TOKEN_FILE" ]; then
    echo "CPAK SYSTEM BROKER ERROR: broker is unavailable." >&2
    exit 1
fi

exec /usr/local/bin/cpak system-broker-client --operation "$OPERATION" -- "$@"
